<Window x:Class="Profanity_Steam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profanity" Height="560" Width="780" WindowStyle="None" ResizeMode="NoResize" Background="#181818" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="BackgroundBorder" CornerRadius="11" Background="#333333" BorderBrush="#555555" BorderThickness="1"/>
                            <Ellipse x:Name="Dot" Width="14" Height="14" Fill="#AAAAAA" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF6A00"/>
                                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#FF8833"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Dot" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernNavTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3D3D3D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF6A00"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF8833"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6A00"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FF8833"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#DD5500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#CC2929"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EE3B3B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Sidebar Navigation -->
        <Border Background="#242424" BorderBrush="#333333" BorderThickness="1" Width="160" HorizontalAlignment="Left" Margin="10" CornerRadius="8">
            <Grid>
                <StackPanel Margin="8,20,8,0">
                    <RadioButton x:Name="TabMain" Style="{StaticResource ModernNavTab}" IsChecked="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Main" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabGames" Style="{StaticResource ModernNavTab}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Games" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabLibrary" Style="{StaticResource ModernNavTab}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Library" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,12">
                    <Separator Background="#3A3A3A" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="36" Height="36">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/icon.png" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            <Separator Background="#3A3A3A" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding CurrentDate}" Foreground="#888888" FontSize="10"/>
                            <Label Content="Made by Phil" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Background="#242424" BorderBrush="#333333" BorderThickness="1" Margin="180,10,10,10" CornerRadius="8">
            <Grid>
                <!-- MAIN TAB -->
                <Grid Visibility="{Binding IsChecked, ElementName=TabMain, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,16,16,8">
                        <TextBlock Text="Engine Settings" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Grid.Row="1" Background="#3A3A3A" Margin="16,0,16,16"/>

                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                        <Border Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Run in Background" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Minimize to system tray when closed" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding RunInBackground, Mode=TwoWay}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Run on System Startup" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Automatically launch Profanity when Windows starts" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding RunOnStartup, Mode=TwoWay}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#1D1D1D" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Steam Spoofing Service" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Inject manifest hooks automatically into Steam" Foreground="#888888" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding EnableSpoofing, Mode=TwoWay}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- GAMES TAB -->
                <Grid Visibility="{Binding IsChecked, ElementName=TabGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,16,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pirated Games" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Revoke Pirated Content" Click="RevokeButton_Click" Style="{StaticResource DangerButton}" Height="32" Padding="12,0" FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Content="Unlock Content" Click="GetGamesButton_Click" Style="{StaticResource SuccessButton}" Height="32" Padding="12,0" FontSize="12" FontWeight="Bold" Margin="0,0,10,0"/>
                            <Button Content="Add Lua Script" Click="AddGameButton_Click" Style="{StaticResource ModernButton}" Height="32" Padding="12,0" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Background="#3A3A3A" Margin="16,0,16,16"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MyGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="70" Margin="16,0,16,10" Background="#1D1D1D" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <Border Grid.Column="1" Width="106" Height="50" CornerRadius="4" Background="#2A2A2A" Margin="12,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="App ID: " Foreground="#888888" FontSize="12"/>
                                                    <TextBlock Text="{Binding AppId}" Foreground="#888888" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="3" Content="Remove" Click="RemoveGameButton_Click" Style="{StaticResource DangerButton}" Width="75" Height="30" Margin="0,0,12,0" FontSize="12" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- LIBRARY TAB -->
                <Grid Visibility="{Binding IsChecked, ElementName=TabLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Discover More Games" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Browse and generate manifests directly from the web." Foreground="#888888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <Button Content="Find Games Online" Click="FindGamesButton_Click" Style="{StaticResource ModernButton}" Height="40" Width="200" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>